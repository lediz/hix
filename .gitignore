# Build cache Harbour
**/.hbmk/*
**/.cached/*
**/.log.syncro/*
**/tmp/*

# Binaries compiled
*.exe
*.lib

# WDO MySQL/MariaDB runtime DLLs — force-include
!resources/wdo/mysql/dll/*.dll





# Build output (Linux/gcc)
lib/
*.hbx

# Generated C next to its .prg
hix_helpers.c

# Backups: git is the rollback mechanism
*.bak

# Unit-test harness output (tests/unit)
trace.log
traces/
tests/unit/app
nul

# Runtime data. The app and the test suites write these in place, so they are
# state, not source — every run dirtied the working tree. Regenerate instead:
#   hbmk2 regenerate_users.hbp && ./regenerate_users   -> webapp/data/users.{dbf,cdx}
#   hbmk2 regenerate_data.hbp  && ./regenerate_data    -> webapp/data/customers.{dbf,cdx}
# Run them from webapp/ (they write to ./data); HIX_DATA_DIR overrides.
# states.{dbf,cdx} has no generator; it is byte-identical to the tracked
# examples/web/crud/data/states.{dbf,cdx} — copy from there.
webapp/data/*.dbf
webapp/data/*.cdx

# Seeder binaries, built by the .hbp files next to their sources
webapp/regenerate_users
webapp/regenerate_data

# The test suite is local tooling, not part of what ships: tests/run.sh and
# its slices, the shared lib/, and the unit-test harness under tests/unit/
# (its .prg sources, build files and www/ assets) are untracked on 2026-10-07
# — 112 paths, staged with `git rm -r --cached tests/`. Everything still lives
# on disk and the suite still runs; a fresh clone simply has no tests until
# they are added back. Re-instate with `git add -f tests/` plus the paths you
# want, and drop this rule.
tests/

# Same for the ad-hoc probes and harnesses under webapp/test/ — local tooling,
# not part of what ships. Untracked on 2026-10-07 (12 paths, staged with `git
# rm -r --cached webapp/test/`); everything still lives on disk and the probes
# still run. Re-instate with `git add -f webapp/test/` and drop this rule.
webapp/test/
