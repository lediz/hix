# Build cache Harbour
**/.hbmk/*
**/.cached/*
**/.log.syncro/*
**/tmp/*

# Binaries compiled
*.exe
*.lib

# WDO MySQL/MariaDB runtime DLLs — force-include
!resources/wdo/mysql/dll/*.dll





# Build output (Linux/gcc)
lib/
*.hbx

# Generated C next to its .prg
hix_helpers.c

# Backups: git is the rollback mechanism
*.bak

# Unit-test harness output (tests/unit)
trace.log
traces/
tests/unit/app
nul

# Runtime data. The app and the test suites write these in place, so they are
# state, not source — every run dirtied the working tree. Regenerate instead:
#   hbmk2 regenerate_users.hbp && ./regenerate_users   -> webapp/data/users.{dbf,cdx}
#   hbmk2 regenerate_data.prg  && ./regenerate_data    -> webapp/data/customers.{dbf,cdx}
# WARNING: both seeders still hardcode cPath := "/home/jack/Projects/pi-agent/webapp/data",
# an older checkout that is still on disk — they write there, not here.
# states.{dbf,cdx} has no generator; it is byte-identical to the tracked
# examples/web/crud/data/states.{dbf,cdx} — copy from there.
webapp/data/*.dbf
webapp/data/*.cdx
