# ============================================================
# seed_inventree.hbp - P1.6 of INVENTREE-MYSQL-PLAN.md
#
# CLI seeder: sql/fixtures/<table>.csv -> the MariaDB host under .mysql/.
# Same link shape as app.hbp / create_mysql_sql.hbp: the WDO MySQL driver
# is framework code (src/wdo/mysql/*.prg -> hix_server.hbx), so this
# tool needs the framework and nothing else. Built with hbmk2 only.
#
# Build:  hix=<framework root> hbmk2 seed_inventree.hbp
# Run  :  ./seed_inventree [seed|verify]   (MYSQL_PWD from .mysql/credentials)
#
# Order of the corpus is the schema file's order (FK dependency order),
# not the directory's.
# ============================================================

-n
-w1
-es2
-mt
-workdir=.hbmk/${hb_compiler}/seed_inventree

-hbexe
-oseed_inventree

seed_inventree.prg

${hix}/hix_server.hbx
${hix}/hix_server.hbc
${hb_root}/include/harbour.hbx
