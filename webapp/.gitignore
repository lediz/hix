# Build artifacts
.hbmk/
app
.hbmk/gcc/app/*.o
.hbmk/gcc/app/*.c

# Adhoc tool binaries built from the .hbp files in this folder
create_cdx
create_dbf_ntx
migrate_dbf
migrate_users
regenerate_data
regenerate_users
probe_entropy
probe_hash
probe_pwcost
probe_seek

# TLS material: a private key must never enter the repository
# (hix/site-docs/en/hixstyle/seguridad/ssl.md).  Create with ./gen_cert.sh
certs/

# Session files
sessions/
.sessions/

# Logs
.logs/
trace.log

# Compiled views
.cached/

# Per-installation app config: HIX rewrites it at startup and it now holds
# this installation's signing keys.  Template: www/config.json.example
www/config.json

# Scratch / verification folders
.tmp_verify/
tmp/

# Backups (git is the rollback mechanism - see D-14)
*.bak

# Node (pi tooling, not part of the Harbour/HIX app)
node_modules/
package-lock.json

# OS files
.DS_Store
Thumbs.db
