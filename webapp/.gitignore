# Build artifacts
.hbmk/
app
.hbmk/gcc/app/*.o
.hbmk/gcc/app/*.c

# Adhoc tool binaries built from the .hbp files in this folder
create_cdx
create_dbf_ntx
migrate_users
regenerate_data
regenerate_users
probe_entropy
probe_hash
probe_pwcost
probe_seek
probe_fmode

# TLS material: a private key must never enter the repository
# (hix/site-docs/en/hixstyle/seguridad/ssl.md).  Create with ./gen_cert.sh
certs/

# Session files
sessions/
.sessions/

# Logs
.logs/
trace.log

# Compiled views
.cached/

# Per-installation app config: HIX rewrites it at startup.  It must NOT hold
# signing keys any more - www/ is the document root and its root-level files
# are downloadable (PENTEST-REPORT.md §1).  Template: www/config.json.example
www/config.json

# Signing keys: outside paths.root, 0600, created by ./gen_keys.sh.
hix.keys.json

# Scratch / verification folders
.tmp_verify/
.tmp_probe_fmode/
tmp/

# Backups (git is the rollback mechanism - see D-14)
*.bak

# P0 MySQL/MariaDB runtime: the database itself, its log, its socket,
# the server binaries unpacked from the distribution package, and the
# account password. State, never source - same discipline as hix.keys.json
# and certs/. Created by ./gen_mysql_db.sh.
.mysql/

# P0 probe binary, built from probe_mysql.hbp like the other probes here
probe_mysql

# P1 tool binaries, built from the .hbp files next to their sources
# (hbmk2 drops them in this folder, like every other adhoc tool here)
create_mysql_sql
seed_inventree

# P3 harness binary (the harness source lives in webapp/test/, which is
# already ignored; the binary lands in this folder, so name it here)
probe_dalmysql

# P4.8 seeder binary, built from seed_users_mysql.hbp next to its sources
seed_users_mysql

# P1.7: sql/ is SOURCE and stays tracked - webapp/sql/inventree.sql is the
# schema that ships, webapp/sql/fixtures/*.csv is the seed corpus (the CSV
# equivalent of InvenTree's own Django fixtures). Nothing under sql/ is
# generated at runtime; the database itself is .mysql/ above, which is
# ignored. Do not add a rule for sql/.

# Node (pi tooling, not part of the Harbour/HIX app)
node_modules/
package-lock.json

# OS files
.DS_Store
Thumbs.db

# Compiled loaders (HIX regenerates them from .prg at startup)
*.hrb
*.hrb.md5
*.log
# Generated C: harbour/hbmk2 drop it next to the .prg when there is no
# -workdir (the .hbp files send it into .hbmk/).  Anchored to this folder so
# nothing under www/ or test/ is affected.
/*.c
# Generated C from .prg tests
*_customer_module.c
# Python test caches
__pycache__/
# Generated report output (regenerate from the .md)
COMPARATIVE-ANALYSIS.pdf

# Stray DBF from a path-concat bug (real data lives in data/)
/datacustomers.dbf

# Compile probe generated by test/test_users_module.sh
u_check.c
