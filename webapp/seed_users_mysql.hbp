# ============================================================
# seed_users_mysql.hbp - P4.8 of INVENTREE-MYSQL-PLAN.md
#
# CLI seeder for HIX's own credential store: sql/hix_users.sql + the
# five seed accounts -> the MariaDB host under .mysql/.
#
# Same link shape as app.hbp / create_mysql_sql.hbp / seed_inventree.hbp:
# the WDO MySQL driver is framework code (src/wdo/mysql/*.prg ->
# hix_server.hbx), so this tool needs the framework and nothing else.
# Built with hbmk2 only, like every other tool in this folder (T7).
#
# Passwords are hashed at run time by www/models/hpassword.prg, so no
# digest and no salt is committed - which is why there is no fixture CSV
# for this table, unlike the inventory corpus.
#
# Build:  hix=<framework root> hbmk2 seed_users_mysql.hbp
# Run  :  ./seed_users_mysql [create|seed|verify|check|dump]
#         (MYSQL_PWD from .mysql/credentials, kept by ./gen_mysql_db.sh)
# ============================================================

-n
-w1
-es2
-iwww
-mt
-workdir=.hbmk/${hb_compiler}/seed_users_mysql

-hbexe
-oseed_users_mysql

seed_users_mysql.prg

${hix}/hix_server.hbx
${hix}/hix_server.hbc
${hb_root}/include/harbour.hbx
