# probe_dalmysql.hbp - P3 harness (CLI, local tooling like the other probes)
# Compiles the DAL itself (www/models/tdalmysql.prg) next to the harness, so
# the checks run against the same class the WebApp runtime-loads.
# Build:  hix=<framework root> hbmk2 probe_dalmysql.hbp
-n
-w1
-es2
-mt
-workdir=.hbmk/${hb_compiler}/probe_dalmysql

-hbexe
-oprobe_dalmysql

test/probe_dalmysql.prg
www/models/tdalmysql.prg

${hix}/hix_server.hbx
${hix}/hix_server.hbc
${hb_root}/include/harbour.hbx
